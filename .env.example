# Email por SMTP con STARTTLS. Se activa con SMTP_HOST y SMTP_USER.
# Gmail no acepta tu contraseña normal: generá una contraseña de aplicación
# (Cuenta de Google > Seguridad > Contraseñas de aplicaciones) y usala en SMTP_PASSWORD.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-cuenta@gmail.com
# SMTP_PASSWORD=
# Remitente; vacío = usa SMTP_USER
# SMTP_FROM=
